#!/usr/bin/env python3
import json
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
PROFILES = sorted(p.stem for p in HERE.glob("*.json"))
USAGE = f"usage: bee-team-profile <{'|'.join(PROFILES)}|status> [--force] [project-root ...]"


def load(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return {}


def save(path, data):
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def registered_roots():
    out = subprocess.run(["waggledance", "list", "--json"], capture_output=True, text=True, check=True)
    return [Path(p["root_path"]) for p in json.loads(out.stdout)["projects"]]


def covered(base, profile):
    team = base.get("team") or {}
    return any(role in (team.get(rt) or {}) for rt, roles in profile["team"].items() for role in roles)


def effective_agent(base, overlay, rt, role):
    over = ((overlay.get("team") or {}).get(rt) or {}).get(role) or {}
    if "agent" in over:
        return over["agent"]
    entry = ((base.get("team") or {}).get(rt) or {}).get(role) or {}
    return entry.get("agent") or (f"native:{entry['model']}" if entry.get("model") else None)


def active_profile(base, overlay, profiles):
    current = {(rt, role): effective_agent(base, overlay, rt, role)
               for rt, roles in profiles[PROFILES[0]]["team"].items() for role in roles}
    for name, prof in profiles.items():
        if all(current.get((rt, role)) == agent for rt, roles in prof["team"].items() for role, agent in roles.items()):
            return name
    return "mixed"


def normalize_base(base, profile):
    changed = []
    for rt, roles in profile["team"].items():
        entries = (base.get("team") or {}).get(rt) or {}
        for role in roles:
            entry = entries.get(role)
            if isinstance(entry, dict) and "model" in entry and "agent" not in entry:
                entries[role] = {k: v for k, v in entry.items() if k not in ("model",)}
                entries[role].update({"kind": "herding", "agent": "paseo-pi-agy-flash"})
                changed.append(f"{rt}.{role}")
    return changed


def apply(root, profile, profiles, force):
    bee = root / ".bee"
    base_path, overlay_path = bee / "config.json", bee / "config.local.json"
    base = load(base_path)
    if not covered(base, profile):
        return "skipped (no bee team config)"
    if not force and active_profile(base, load(overlay_path), profiles) == "mixed":
        return "skipped (custom team, rerun with --force to overwrite)"
    fixed = normalize_base(base, profile)
    if fixed:
        save(base_path, base)
    overlay = load(overlay_path)
    team = overlay.setdefault("team", {})
    for rt, roles in profile["team"].items():
        for role, agent in roles.items():
            team.setdefault(rt, {})[role] = {"kind": "herding", "agent": agent}
    agents = overlay.setdefault("herding", {}).setdefault("agents", {})
    agents.update(profile.get("herding_agents") or {})
    save(overlay_path, overlay)
    return "applied" + (f" (base normalized: {', '.join(fixed)})" if fixed else "")


def main(argv):
    if not argv or argv[0] not in PROFILES + ["status"]:
        print(USAGE, file=sys.stderr)
        return 2
    profiles = {name: load(HERE / f"{name}.json") for name in PROFILES}
    force = "--force" in argv
    roots = [Path(a).resolve() for a in argv[1:] if a != "--force"] or registered_roots()
    for root in roots:
        base_path = root / ".bee" / "config.json"
        if not base_path.is_file():
            continue
        if argv[0] == "status":
            base = load(base_path)
            if covered(base, profiles[PROFILES[0]]):
                print(f"{root.name:28} {active_profile(base, load(root / '.bee' / 'config.local.json'), profiles)}")
            continue
        print(f"{root.name:28} {apply(root, profiles[argv[0]], profiles, force)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
